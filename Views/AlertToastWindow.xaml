<Window x:Class="NetSentry.Views.AlertToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetSentry Bandwidth Alert"
        Width="380" Height="175"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Margin="8"
            Background="#161822"
            BorderBrush="#FF4757"
            BorderThickness="1.5"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.8" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Warning Icon, Title, and Close Button -->
            <Grid Grid.Row="0" Margin="14,12,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3D1A24" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="⚠️ BANDWIDTH ALERT" Foreground="#FF6B81" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock x:Name="TxtLimitTag" Text="Limit: 1.0 Mbps" Foreground="#8B8F9F" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnClose" Content="✕" Width="22" Height="22"
                        Background="Transparent" Foreground="#8B8F9F" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33374A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Row 1: App Info & Speed -->
            <Grid Grid.Row="1" Margin="14,2,14,6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <Border Grid.Column="0" Width="36" Height="36" Background="#252836" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image x:Name="ImgAppIcon" Width="24" Height="24" Stretch="Uniform"/>
                </Border>

                <!-- Process Name & Path -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtAppName" Text="Application" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtAppPath" Text="PID: 0000" Foreground="#8B8F9F" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Speed Badge -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSpeedMbps" Text="0.00 Mbps" Foreground="#FF4757" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtSpeedRaw" Text="0 KB/s" Foreground="#00D2FF" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Status / Result Message (Hidden by default, shown upon action) -->
            <Border x:Name="BannerActionFeedback" Grid.Row="2" Background="#1D3E2F" CornerRadius="6" Margin="14,0,14,8" Padding="8,5" Visibility="Collapsed">
                <TextBlock x:Name="TxtActionFeedback" Text="Application blocked in Windows Firewall!" Foreground="#00FFA3" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
            </Border>

            <!-- Row 2: Action Buttons -->
            <Grid x:Name="PanelButtons" Grid.Row="2" Margin="14,0,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Block Button -->
                <Button Grid.Column="0" x:Name="BtnBlock" Click="BtnBlock_Click" Height="28" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#3B1C24" BorderBrush="#5C2533" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" Margin="0,0,6,0" FontSize="11"/>
                                    <TextBlock Text="Block Now" Foreground="#FF6B81" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Open App / Review Button -->
                <Button Grid.Column="2" x:Name="BtnOpenNetSentry" Click="BtnOpenNetSentry_Click" Height="28" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1C2E3B" BorderBrush="#254F66" BorderThickness="1" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" Margin="0,0,6,0" FontSize="11"/>
                                    <TextBlock Text="Open App" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 3: Auto-dismiss Progress Bar -->
            <ProgressBar Grid.Row="3" x:Name="ProgressDismiss" Minimum="0" Maximum="100" Value="100"
                         Background="#252836" Foreground="#FF4757" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
