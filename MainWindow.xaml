<Window x:Class="NetSentry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:NetSentry.Converters"
        mc:Ignorable="d"
        Title="NetSentry - Bandwidth Sentinel" Height="760" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#111219"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:ThresholdToBrushConverter x:Key="ThresholdToBrush"/>
        <converters:StatusBgBrushConverter x:Key="StatusBgBrush"/>

        <!-- ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1A1C26"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E212E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D3245"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3042"/>
                    <Setter Property="BorderBrush" Value="#00D2FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Block Button Style -->
        <Style x:Key="BlockBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#3B1C24"/>
            <Setter Property="Foreground" Value="#FF6B81"/>
            <Setter Property="BorderBrush" Value="#5C2533"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4757"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#FF6B81"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Unblock Button Style -->
        <Style x:Key="UnblockBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#1C3829"/>
            <Setter Property="Foreground" Value="#2ED573"/>
            <Setter Property="BorderBrush" Value="#25543A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ED573"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="BorderBrush" Value="#2ED573"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sort Button Style -->
        <Style x:Key="SortBtn" TargetType="Button">
            <Setter Property="Background" Value="#171A24"/>
            <Setter Property="Foreground" Value="#8B8F9F"/>
            <Setter Property="BorderBrush" Value="#262A3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222738"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#3B4259"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Sort Button Style -->
        <Style x:Key="HeaderSortBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- 4 Stat Cards -->
            <RowDefinition Height="Auto"/> <!-- Breach Alert Banner -->
            <RowDefinition Height="*"/>    <!-- Content Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer with Creator Credits -->
        </Grid.RowDefinitions>

        <!-- 1. Cleaned-Up Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Clean Header Brand -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="#181B26" CornerRadius="10" BorderBrush="#00D2FF" BorderThickness="1.5" Margin="0,0,12,0">
                    <TextBlock Text="🛡️" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NetSentry" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#1C2E3B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.2" Foreground="#00D2FF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Active Network Sentinel &amp; Firewall Guard" FontSize="11" Foreground="#8B8F9F" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Compact Header Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status Pill -->
                <Border Background="#132A1E" BorderBrush="#1C4B31" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#2ED573" Margin="0,0,6,0"/>
                        <TextBlock Text="Live Sentinel" Foreground="#2ED573" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Mute Alerts Checkbox -->
                <CheckBox x:Name="ChkMuteAlerts" Content="Mute Alerts" Foreground="#CBD5E1" FontSize="11" 
                          VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" Click="ChkMuteAlerts_Click"
                          ToolTip="Silence popup notifications and floating alert toasts"/>

                <!-- Run on Startup Checkbox -->
                <CheckBox x:Name="ChkRunOnStartup" Content="Run on Startup" Foreground="#CBD5E1" FontSize="11" 
                          VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" Click="ChkRunOnStartup_Click"
                          ToolTip="Automatically launch NetSentry minimized in tray when Windows boots"/>

                <!-- Header Action Buttons -->
                <Button Content="🔔 Test Alert" Style="{StaticResource ModernBtn}" Click="BtnTestAlert_Click" Margin="0,0,6,0" FontSize="11" ToolTip="Test how the high bandwidth alert looks on your screen"/>
                <Button Content="🔄 Refresh" Style="{StaticResource ModernBtn}" Click="BtnRefreshAll_Click" Margin="0,0,6,0" FontSize="11" ToolTip="Refresh active processes and firewall rules"/>
                <Button Content="📥 To Tray" Style="{StaticResource ModernBtn}" Click="BtnMinimizeToTray_Click" FontSize="11" ToolTip="Minimize NetSentry to system tray"/>
            </StackPanel>
        </Grid>

        <!-- 2. Balanced 4-Card Dashboard with Live Speed + Total Session Data -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.35*"/> <!-- Wider for Session Data breakdown -->
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Live Download Speed -->
            <Border Grid.Column="0" Background="#161822" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="#262A3B" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="↓ " FontSize="11" FontWeight="Bold" Foreground="#00D2FF"/>
                        <TextBlock Text="LIVE DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#8B8F9F"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDownloadSpeed" Text="0.0 B/s" FontSize="22" FontWeight="Bold" Foreground="#00D2FF"/>
                    <TextBlock x:Name="TxtDownloadMbps" Text="0.00 Mbps" FontSize="11" Foreground="#8B8F9F" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Live Upload Speed -->
            <Border Grid.Column="1" Background="#161822" CornerRadius="10" Padding="14,12" Margin="4,0,8,0" BorderBrush="#262A3B" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="↑ " FontSize="11" FontWeight="Bold" Foreground="#A855F7"/>
                        <TextBlock Text="LIVE UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#8B8F9F"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtUploadSpeed" Text="0.0 B/s" FontSize="22" FontWeight="Bold" Foreground="#A855F7"/>
                    <TextBlock x:Name="TxtUploadMbps" Text="0.00 Mbps" FontSize="11" Foreground="#8B8F9F" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Session Data Usage (Since App Started) -->
            <Border Grid.Column="2" Background="#161822" CornerRadius="10" Padding="14,12" Margin="4,0,8,0" BorderBrush="#262A3B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with Session Timer and Reset button -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="SESSION USAGE" FontSize="10" FontWeight="Bold" Foreground="#8B8F9F" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtSessionDuration" Text="⏱️ 00:00:00" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnResetSession" Content="↺" ToolTip="Reset session counter to 0" 
                                    Width="16" Height="16" Background="Transparent" Foreground="#6B7280" BorderThickness="0" 
                                    FontSize="10" Cursor="Hand" Click="BtnResetSession_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Big Total Data Consumed -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock x:Name="TxtSessionTotal" Text="0.0 MB" FontSize="22" FontWeight="Bold" Foreground="#2ED573"/>
                        <TextBlock Text=" total" FontSize="11" Foreground="#8B8F9F" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>

                    <!-- Download & Upload Breakdown Badges -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Background="#1C2E3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtSessionDownload" Text="↓ 0.0 MB" Foreground="#00D2FF" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#2A1B36" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtSessionUpload" Text="↑ 0.0 MB" Foreground="#C084FC" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Alert Threshold -->
            <Border Grid.Column="3" Background="#161822" CornerRadius="10" Padding="14,12" Margin="4,0,0,0" BorderBrush="#262A3B" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="11" Foreground="#FFA502"/>
                            <TextBlock Text="TRIGGER LIMIT" FontSize="10" FontWeight="Bold" Foreground="#8B8F9F"/>
                        </StackPanel>
                        <TextBlock Text="5s delay" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtThresholdVal" Text="1.0" FontSize="22" FontWeight="Bold" Foreground="#FFA502"/>
                        <TextBlock Text=" Mbps" FontSize="12" Foreground="#FFA502" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                    </StackPanel>
                    <Slider x:Name="SliderThreshold" Minimum="0.5" Maximum="10.0" Value="1.0" SmallChange="0.5" TickFrequency="0.5" 
                            IsSnapToTickEnabled="True" Margin="0,5,0,0" ValueChanged="SliderThreshold_ValueChanged"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Alert Banner (Visible if any app exceeds threshold) -->
        <Border x:Name="AlertBanner" Grid.Row="2" Background="#331A22" BorderBrush="#FF4757" BorderThickness="1" 
                CornerRadius="8" Padding="12,9" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAlertMessage" Text="Warning: App is consuming high bandwidth!" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#FF6B81" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnQuickBlockAlert" Grid.Column="1" Content="🛡️ Block Now" Style="{StaticResource BlockBtn}" Click="BtnQuickBlockAlert_Click"/>
            </Grid>
        </Border>

        <!-- 4. Content Tabs -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#1A1C26"/>
                    <Setter Property="Foreground" Value="#8B8F9F"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#252836"/>
                                        <Setter Property="Foreground" Value="#00D2FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Live Apps & Bandwidth -->
            <TabItem Header="📊 Active Apps &amp; Bandwidth">
                <Border Background="#161822" CornerRadius="0,8,8,8" Padding="14" Margin="0,8,0,0" BorderBrush="#262A3B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box, Sort Pills & Active Count -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Search Input -->
                            <Border Background="#10121A" CornerRadius="6" BorderBrush="#2D3245" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" 
                                             Padding="10,6" FontSize="12" TextChanged="TxtSearch_TextChanged"
                                             ToolTip="Filter processes by name..."/>
                                    <TextBlock Text="🔍 Filter applications..." Foreground="#6B7280" FontSize="11" Margin="10,7,0,0" 
                                               IsHitTestVisible="False" Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Quick Sort Selector Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Sort:" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnSortUsage" Content="⚡ Total Rate" Style="{StaticResource SortBtn}" Tag="UsageDesc" Click="BtnSort_Click" ToolTip="Sort by Highest Total Bandwidth Rate" Margin="0,0,4,0"/>
                                <Button x:Name="BtnSortDownload" Content="↓ Download" Style="{StaticResource SortBtn}" Tag="DownloadDesc" Click="BtnSort_Click" ToolTip="Sort by Download Speed" Margin="0,0,4,0"/>
                                <Button x:Name="BtnSortUpload" Content="↑ Upload" Style="{StaticResource SortBtn}" Tag="UploadDesc" Click="BtnSort_Click" ToolTip="Sort by Upload Speed" Margin="0,0,4,0"/>
                                <Button x:Name="BtnSortName" Content="🔤 Name" Style="{StaticResource SortBtn}" Tag="NameAsc" Click="BtnSort_Click" ToolTip="Sort Alphabetically by Application Name" Margin="0,0,4,0"/>
                                <Button x:Name="BtnSortBlocked" Content="🔒 Blocked" Style="{StaticResource SortBtn}" Tag="BlockedFirst" Click="BtnSort_Click" ToolTip="Show Blocked Applications at the Top"/>
                            </StackPanel>

                            <!-- Active Count Badge -->
                            <Border Grid.Column="2" Background="#1D2130" CornerRadius="6" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAppCount" Text="0 Apps Active" Foreground="#A0AEC0" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Column Headers Bar (Interactive & Sortable) -->
                        <Grid Grid.Row="1" Margin="12,0,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="1" Style="{StaticResource HeaderSortBtn}" Tag="NameAsc" Click="BtnSort_Click" HorizontalAlignment="Left" ToolTip="Click to sort by Application Name">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="APPLICATION / PROCESS" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TxtHeaderSortName" Text="" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Foreground="#00D2FF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource HeaderSortBtn}" Tag="DownloadDesc" Click="BtnSort_Click" HorizontalAlignment="Left" ToolTip="Click to sort by Download Speed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↓ DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TxtHeaderSortDownload" Text="" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Foreground="#00D2FF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource HeaderSortBtn}" Tag="UploadDesc" Click="BtnSort_Click" HorizontalAlignment="Left" ToolTip="Click to sort by Upload Speed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↑ UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TxtHeaderSortUpload" Text="" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Foreground="#00D2FF"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource HeaderSortBtn}" Tag="UsageDesc" Click="BtnSort_Click" HorizontalAlignment="Left" ToolTip="Click to sort by Total Bandwidth Rate">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ TOTAL RATE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock x:Name="TxtHeaderSortUsage" Text=" ▼" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Foreground="#00D2FF"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="5" Text="FIREWALL / CONTROL" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Process List View -->
                        <ListView x:Name="LstProcesses" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#1A1C27"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#25293A" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#222636"/>
                                                        <Setter Property="BorderBrush" Value="#38405A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                        <!-- Name & Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat=' (PID: {0})'}" Foreground="#6B7280" FontSize="11" Margin="4,2,0,0"/>
                                                <!-- Blocked Status Badge -->
                                                <Border Background="#3B1C24" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" 
                                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="🔒 BLOCKED" Foreground="#FF4757" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <!-- High Alert Badge -->
                                                <Border Background="#3D2914" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" 
                                                        Visibility="{Binding IsAboveThreshold, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="⚠️ HIGH USAGE" Foreground="#FFA502" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Download Speed -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DownloadSpeedFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="#00D2FF"/>
                                        </StackPanel>

                                        <!-- Upload Speed -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UploadSpeedFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="#C084FC"/>
                                        </StackPanel>

                                        <!-- Total Speed -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalSpeedFormatted}" FontWeight="Bold" FontSize="13" Foreground="{Binding TotalSpeedMbps, Converter={StaticResource ThresholdToBrush}}"/>
                                        </StackPanel>

                                        <!-- Actions: Dynamic Block / Unblock Toggle -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Show Block Button when NOT blocked -->
                                            <Button Content="🛡️ Block" Style="{StaticResource BlockBtn}" Tag="{Binding}" Click="BtnBlockProcess_Click" 
                                                    Margin="0,0,6,0" Padding="10,4" FontSize="11" Width="82"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource InverseBoolToVis}}"/>

                                            <!-- Show Unblock Button when IS blocked -->
                                            <Button Content="🟢 Unblock" Style="{StaticResource UnblockBtn}" Tag="{Binding}" Click="BtnBlockProcess_Click" 
                                                    Margin="0,0,6,0" Padding="10,4" FontSize="11" Width="82"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"/>

                                            <Button Content="✕" Style="{StaticResource ModernBtn}" Tag="{Binding}" Click="BtnKillProcess_Click" Padding="8,4" FontSize="11" ToolTip="Terminate process"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Windows Update & OS Services Sentinel -->
            <TabItem Header="⚡ Windows Update &amp; Services">
                <Border Background="#161822" CornerRadius="0,8,8,8" Padding="16" Margin="0,8,0,0" BorderBrush="#262A3B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Master Buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows OS Background Services" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Block or allow background Windows Update, Store downloads, and Delivery Optimization." FontSize="11" Foreground="#8B8F9F"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🔒 Lock All Updaters" Style="{StaticResource BlockBtn}" Click="BtnLockAllServices_Click" Margin="0,0,8,0" Padding="12,6"/>
                                <Button Content="🟢 Unlock All Services" Style="{StaticResource UnblockBtn}" Click="BtnUnlockAllServices_Click" Padding="12,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Services List -->
                        <ListView x:Name="LstSystemServices" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#1A1C27"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#25293A" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Service Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" Background="#242838" CornerRadius="8" Margin="0,0,14,0">
                                            <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title & Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                                <Border Background="#25293A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ServiceNames, StringFormat='Svc: {0}'}" Foreground="#A0AEC0" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8B8F9F" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" Background="{Binding IsBlocked, Converter={StaticResource StatusBgBrush}}" 
                                                CornerRadius="12" Padding="12,4" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Border>

                                        <!-- Toggle Button -->
                                        <Button Grid.Column="3" Content="{Binding ActionButtonText}" 
                                                Style="{Binding IsBlocked, Converter={StaticResource ThresholdToBrush}}"
                                                Tag="{Binding}" Click="BtnToggleService_Click" VerticalAlignment="Center" Padding="12,6"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: Blocked Firewall Rules -->
            <TabItem Header="🛡️ Blocked Firewall Rules">
                <Border Background="#161822" CornerRadius="0,8,8,8" Padding="16" Margin="0,8,0,0" BorderBrush="#262A3B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Add Rule -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Active Outbound Block Rules" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="All custom and system outbound block rules currently active in Windows Firewall." FontSize="11" Foreground="#8B8F9F"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="➕ Block Custom App (.exe)" Style="{StaticResource ModernBtn}" Click="BtnAddCustomBlock_Click" Margin="0,0,8,0" Padding="12,6"/>
                                <Button Content="🔄 Refresh Rules" Style="{StaticResource ModernBtn}" Click="BtnRefreshBlocked_Click" Padding="12,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Blocked Rules List -->
                        <ListView x:Name="LstBlockedRules" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#1A1C27"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#25293A" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lock Icon -->
                                        <TextBlock Grid.Column="0" Text="🔒" FontSize="16" VerticalAlignment="Center"/>

                                        <!-- Rule Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RuleName}" FontWeight="Bold" FontSize="13" Foreground="#FF6B81"/>
                                                <Border Background="#25293A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Direction}" Foreground="#A0AEC0" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProgramPath}" FontSize="11" Foreground="#8B8F9F" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Action Status Badge -->
                                        <Border Grid.Column="2" Background="#3B1C24" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="BLOCKED" Foreground="#FF4757" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <!-- Unblock Button -->
                                        <Button Grid.Column="3" Content="🟢 Unblock" Style="{StaticResource UnblockBtn}" Tag="{Binding}" Click="BtnUnblockRule_Click" VerticalAlignment="Center" Padding="12,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: Session History & Data Logs -->
            <TabItem Header="📜 Session History">
                <Border Background="#161822" CornerRadius="0,8,8,8" Padding="16" Margin="0,8,0,0" BorderBrush="#262A3B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- All-time summary banner -->
                            <RowDefinition Height="Auto"/> <!-- Table column headers -->
                            <RowDefinition Height="*"/>    <!-- Session records list -->
                        </Grid.RowDefinitions>

                        <!-- All-Time Lifetime Stats Banner -->
                        <Border Grid.Row="0" Background="#1A1C27" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#2B2F42" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈 All-Time Total Data: " FontSize="12" Foreground="#8B8F9F" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLifetimeTotal" Text="0.0 MB" FontSize="14" FontWeight="Bold" Foreground="#2ED573" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <TextBlock x:Name="TxtLifetimeDownload" Text="↓ 0.0 MB" FontSize="11" Foreground="#00D2FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtLifetimeUpload" Text="↑ 0.0 MB" FontSize="11" Foreground="#C084FC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtTotalSessionCount" Text="(0 Sessions)" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🔄 Refresh Logs" Style="{StaticResource ModernBtn}" Click="BtnRefreshHistory_Click" Margin="0,0,8,0" Padding="10,4" FontSize="11"/>
                                    <Button Content="🗑️ Clear Old Logs" Style="{StaticResource ModernBtn}" Click="BtnClearHistory_Click" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Column Headers -->
                        <Grid Grid.Row="1" Margin="14,0,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="START DATE" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="TIME WINDOW" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="2" Text="⏱️ DURATION" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="3" Text="↓ DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="4" Text="↑ UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="5" Text="📊 TOTAL DATA" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="6" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Sessions List -->
                        <ListView x:Name="LstSessionHistory" Grid.Row="2" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="#1A1C27"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#25293A" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding StartTimeFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeRangeFormatted}" FontSize="11" Foreground="#8B8F9F" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}" FontWeight="Medium" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DownloadFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding UploadFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#C084FC" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding TotalFormatted}" FontWeight="Bold" FontSize="13" Foreground="#2ED573" VerticalAlignment="Center"/>

                                        <Border Grid.Column="6" Background="{Binding IsCurrentSession, Converter={StaticResource StatusBgBrush}}" 
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 5. Footer with Discreet, Classy Creator Credits -->
        <Grid Grid.Row="4" Margin="4,10,4,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#2ED573" Margin="0,0,6,0"/>
                <TextBlock Text="Protection Active" Foreground="#2ED573" FontSize="11" FontWeight="Medium"/>
                <TextBlock Text=" • NetSentry Sentinel" Foreground="#475569" FontSize="11" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="v1.2 • TM • Ventiqo Technologies" Foreground="#475569" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
